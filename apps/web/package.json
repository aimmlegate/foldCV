{
  "name": "foldcv-web",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:generate": "../../.venv/bin/python ../../tools/generate_contracts.py && for schema in ../../contracts/json-schema/*.schema.json; do name=$(basename \"$schema\" .schema.json); json2ts -i \"$schema\" -o \"src/contracts/generated/$name.ts\" --no-banner || exit 1; done && ../../.venv/bin/python ../../tools/generate_contracts.py --clean-types",
    "contracts:check": "../../.venv/bin/python ../../tools/check_contract_drift.py",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:state": "node --import tsx --test --experimental-test-coverage --test-coverage-include='**/src/assistant/*.ts' --test-coverage-include='**/src/rich/*.ts' unit/*.test.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build"
  },
  "dependencies": {
    "@blocknote/core": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@blocknote/shadcn": "0.55.0",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-tabs": "1.1.13",
    "@tailwindcss/vite": "4.1.14",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "docx-preview": "0.4.1",
    "fflate": "0.8.3",
    "monaco-editor": "0.52.2",
    "monaco-yaml": "5.5.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "4.1.14",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.1",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
