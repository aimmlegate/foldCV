    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "transferId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Transferid",
      "type": "string"
    },
    "writerEpoch": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Writerepoch"
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "proposalId",
    "owner",
    "writerEpoch",
    "incarnation",
    "transferId",
    "inverseRef",
    "inverseSha256",
    "inverseBytes",
    "expiresAt",
    "guards"
  ],
  "title": "UndoOwnershipV1",
  "type": "object"
}
