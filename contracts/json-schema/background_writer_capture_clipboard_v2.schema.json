{
  "$defs": {
    "AuthoredRange": {
      "additionalProperties": false,
      "properties": {
        "beforeRevision": {
          "minimum": 1,
          "title": "Beforerevision",
          "type": "integer"
        },
        "blockId": {
          "minLength": 1,
          "title": "Blockid",
          "type": "string"
        },
        "cellId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cellid"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "field": {
          "enum": [
            "content",
            "caption"
          ],
          "title": "Field",
          "type": "string"
        },
        "insertionTarget": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "field": "#/$defs/FieldInsertionTarget",
                  "literal": "#/$defs/LiteralInsertionTarget",
                  "manual_scope": "#/$defs/ManualScopeInsertionTarget"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/FieldInsertionTarget"
                },
                {
                  "$ref": "#/$defs/LiteralInsertionTarget"
                },
                {
                  "$ref": "#/$defs/ManualScopeInsertionTarget"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Insertiontarget"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "blockId",
        "beforeRevision",
        "cellId",
        "field",
        "start",
        "end"
      ],
      "title": "AuthoredRange",
      "type": "object"
    },
    "BlockTarget": {
      "additionalProperties": false,
      "properties": {
        "beforeRevision": {
          "minimum": 1,
          "title": "Beforerevision",
          "type": "integer"
        },
        "blockId": {
          "minLength": 1,
          "title": "Blockid",
          "type": "string"
        }
      },
      "required": [
        "blockId",
        "beforeRevision"
      ],
      "title": "BlockTarget",
      "type": "object"
    },
    "ClipboardBlocksSelection": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/BlockTarget"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "kind": {
          "const": "blocks",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "blocks"
      ],
      "title": "ClipboardBlocksSelection",
      "type": "object"
    },
    "ClipboardRangeSelection": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "range",
          "title": "Kind",
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/AuthoredRange"
        }
      },
      "required": [
        "kind",
        "range"
      ],
      "title": "ClipboardRangeSelection",
      "type": "object"
    },
    "FieldInsertionTarget": {
      "additionalProperties": false,
      "properties": {
        "bindingId": {
          "minLength": 1,
          "title": "Bindingid",
          "type": "string"
        },
        "kind": {
          "const": "field",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "bindingId"
      ],
      "title": "FieldInsertionTarget",
      "type": "object"
    },
    "LiteralInsertionTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "literal",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LiteralInsertionTarget",
      "type": "object"
    },
    "ManualScopeInsertionTarget": {
      "additionalProperties": false,
      "properties": {
        "fragmentId": {
          "minLength": 1,
          "title": "Fragmentid",
          "type": "string"
        },
        "kind": {
          "const": "manual_scope",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "fragmentId"
      ],
      "title": "ManualScopeInsertionTarget",
      "type": "object"
    },
    "TemplateSnapshotIdentity": {
      "additionalProperties": false,
      "properties": {
        "documentHash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Documenthash",
          "type": "string"
        },
        "documentRevision": {
          "minimum": 1,
          "title": "Documentrevision",
          "type": "integer"
        },
        "factsHash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Factshash",
          "type": "string"
        },
        "packageHash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Packagehash",
          "type": "string"
        },
        "presentationHash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Presentationhash",
          "type": "string"
        },
        "projectId": {
          "minLength": 1,
          "title": "Projectid",
          "type": "string"
        },
        "projectRevision": {
          "minimum": 1,
          "title": "Projectrevision",
          "type": "integer"
        }
      },
      "required": [
        "projectId",
        "projectRevision",
        "documentRevision",
        "documentHash",
        "factsHash",
        "packageHash",
        "presentationHash"
      ],
      "title": "TemplateSnapshotIdentity",
      "type": "object"
    },
    "WriterProofV1": {
      "additionalProperties": false,
      "properties": {
        "credential": {
          "maxLength": 128,
          "minLength": 32,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Credential",
          "type": "string"
        },
        "epoch": {
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "incarnation": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Incarnation",
          "type": "string"
        },
        "lineage": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Lineage",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "sessionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Sessionid",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "lineage",
        "epoch",
        "sessionId",
        "incarnation",
        "credential"
      ],
      "title": "WriterProofV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "clientCaptureId": {
      "minLength": 1,
      "title": "Clientcaptureid",
      "type": "string"
    },
    "proof": {
      "$ref": "#/$defs/WriterProofV1"
    },
    "schemaVersion": {
      "const": 2,
      "title": "Schemaversion",
      "type": "integer"
    },
    "selection": {
      "discriminator": {
        "mapping": {
          "blocks": "#/$defs/ClipboardBlocksSelection",
          "range": "#/$defs/ClipboardRangeSelection"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ClipboardRangeSelection"
        },
        {
          "$ref": "#/$defs/ClipboardBlocksSelection"
        }
      ],
      "title": "Selection"
    },
    "snapshot": {
      "$ref": "#/$defs/TemplateSnapshotIdentity"
    }
  },
  "required": [
    "schemaVersion",
    "proof",
    "clientCaptureId",
    "snapshot",
    "selection"
  ],
  "title": "WriterCaptureClipboardV2",
  "type": "object"
}
