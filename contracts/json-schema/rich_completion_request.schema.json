{
  "$defs": {
    "ActionCapture": {
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "minLength": 1,
          "title": "Actionid",
          "type": "string"
        },
        "actionToken": {
          "minimum": 0,
          "title": "Actiontoken",
          "type": "integer"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyStamp"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "sessionId": {
          "minLength": 1,
          "title": "Sessionid",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "actionId",
        "actionToken",
        "dependencies"
      ],
      "title": "ActionCapture",
      "type": "object"
    },
    "DependencyStamp": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fingerprint"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "block",
            "record",
            "field",
            "period",
            "ownership",
            "source",
            "rules",
            "asset",
            "timeline_order"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "fingerprint"
      ],
      "title": "DependencyStamp",
      "type": "object"
    },
    "FieldReference": {
      "additionalProperties": false,
      "properties": {
        "fieldKey": {
          "minLength": 1,
          "title": "Fieldkey",
          "type": "string"
        },
        "recordId": {
          "minLength": 1,
          "title": "Recordid",
          "type": "string"
        },
        "rootId": {
          "minLength": 1,
          "title": "Rootid",
          "type": "string"
        }
      },
      "required": [
        "recordId",
        "fieldKey",
        "rootId"
      ],
      "title": "FieldReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blockIds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Blockids",
      "type": "array"
    },
    "capture": {
      "$ref": "#/$defs/ActionCapture"
    },
    "interpret": {
      "default": true,
      "title": "Interpret",
      "type": "boolean"
    },
    "movedIds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Movedids",
      "type": "array"
    },
    "removedFields": {
      "items": {
        "$ref": "#/$defs/FieldReference"
      },
      "maxItems": 100,
      "title": "Removedfields",
      "type": "array"
    },
    "removedRecordIds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Removedrecordids",
      "type": "array"
    }
  },
  "required": [
    "capture",
    "blockIds",
    "movedIds",
    "removedFields"
  ],
  "title": "RichCompletionRequest",
  "type": "object"
}
