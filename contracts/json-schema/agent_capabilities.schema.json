      },
      "required": [
        "code"
      ],
      "title": "AgentError",
      "type": "object"
    },
    "AgentModelCapability": {
      "additionalProperties": false,
      "properties": {
        "accountEpoch": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Accountepoch",
          "type": "string"
        },
        "binarySha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Binarysha256",
          "type": "string"
        },
        "configSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Configsha256",
          "type": "string"
        },
        "model": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$",
          "title": "Model",
          "type": "string"
        },
        "protocolSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Protocolsha256",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentError"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "unverified",
            "verified",
            "incompatible"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "model",
        "state",
        "binarySha256",
        "protocolSha256",
        "configSha256",
        "accountEpoch",
        "reason"
      ],
      "title": "AgentModelCapability",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "binarySha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Binarysha256"
    },
    "binaryVersion": {
      "maxLength": 128,
      "title": "Binaryversion",
      "type": "string"
    },
    "configSha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Configsha256"
    },
    "connectionEpoch": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Connectionepoch"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/AgentModelCapability"
      },
      "maxItems": 100,
      "title": "Models",
      "type": "array"
    },
    "modes": {
      "items": {
        "enum": [
          "edit",
          "check_only"
        ],
        "type": "string"
      },
      "title": "Modes",
      "type": "array"
    },
    "protocolSha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Protocolsha256"
    },
    "ready": {
      "title": "Ready",
      "type": "boolean"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Tools",
      "type": "array"
    },
    "unavailable": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentError"
        },
        {
          "type": "null"
        }
      ]
    },
    "webAvailable": {
      "title": "Webavailable",
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "ready",
    "binaryVersion",
    "binarySha256",
    "protocolSha256",
    "configSha256",
    "connectionEpoch",
    "modes",
    "tools",
    "webAvailable",
    "models",
    "unavailable"
  ],
  "title": "AgentCapabilities",
  "type": "object"
}
