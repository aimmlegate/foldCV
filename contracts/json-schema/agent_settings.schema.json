{
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "reasoningEffort": {
      "anyOf": [
        {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reasoningeffort"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "selectedAgentModel": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selectedagentmodel"
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "enabled",
    "selectedAgentModel"
  ],
  "title": "AgentSettings",
  "type": "object"
}
