{
  "$defs": {
    "CandidateDetails": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/SupportedText"
        },
        "name": {
          "$ref": "#/$defs/SupportedText"
        },
        "title": {
          "$ref": "#/$defs/SupportedText"
        }
      },
      "required": [
        "name",
        "title",
        "location"
      ],
      "title": "CandidateDetails",
      "type": "object"
    },
    "CertificationDetails": {
      "additionalProperties": false,
      "properties": {
        "dateText": {
          "$ref": "#/$defs/SupportedText"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "issuer": {
          "$ref": "#/$defs/SupportedText"
        },
        "name": {
          "$ref": "#/$defs/SupportedText"
        }
      },
      "required": [
        "id",
        "name",
        "issuer",
        "dateText"
      ],
      "title": "CertificationDetails",
      "type": "object"
    },
    "EducationDetails": {
      "additionalProperties": false,
      "properties": {
        "dateText": {
          "$ref": "#/$defs/SupportedText"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "institution": {
          "$ref": "#/$defs/SupportedText"
        },
        "qualification": {
          "$ref": "#/$defs/SupportedText"
        },
        "specialty": {
          "$ref": "#/$defs/SupportedText"
        }
      },
      "required": [
        "id",
        "institution",
        "qualification",
        "specialty",
        "dateText"
      ],
      "title": "EducationDetails",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "minLength": 1,
          "title": "Sourceid",
          "type": "string"
        },
        "sourceRevision": {
          "minimum": 1,
          "title": "Sourcerevision",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unitId": {
          "minLength": 1,
          "title": "Unitid",
          "type": "string"
        },
        "unitRevision": {
          "minimum": 1,
          "title": "Unitrevision",
          "type": "integer"
        }
      },
      "required": [
        "sourceId",
        "sourceRevision",
        "unitId",
        "unitRevision",
        "text"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "LanguageDetails": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/SupportedText"
        },
        "proficiency": {
          "$ref": "#/$defs/SupportedText"
        }
      },
      "required": [
        "id",
        "name",
        "proficiency"
      ],
      "title": "LanguageDetails",
      "type": "object"
    },
    "LeadershipValue": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "attribution": {
          "enum": [
            "personal",
            "team",
            "organization",
            "unknown"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "teamSize": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action",
        "teamSize",
        "attribution"
      ],
      "title": "LeadershipValue",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "enum": [
            "personal",
            "team",
            "organization",
            "unknown"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline"
        },
        "comparator": {
          "enum": [
            "exact",
            "at_least",
            "at_most",
            "approximately",
            "range"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "number": {
          "title": "Number",
          "type": "number"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Period"
        },
        "qualifiers": {
          "items": {
            "type": "string"
          },
          "title": "Qualifiers",
          "type": "array"
        },
        "result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "upperNumber": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uppernumber"
        }
      },
      "required": [
        "number",
        "upperNumber",
        "comparator",
        "unit",
        "period",
        "baseline",
        "result",
        "scope",
        "attribution",
        "qualifiers"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "NameAssessment": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "missingSurname": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Missingsurname"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "missingSurname",
        "evidence",
        "revision"
      ],
      "title": "NameAssessment",
      "type": "object"
    },
    "ObservationAssessment": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "sourceObservedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sourceObservedAt",
        "evidence",
        "revision"
      ],
      "title": "ObservationAssessment",
      "type": "object"
    },
    "PartialDate": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Day"
        },
        "month": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Month"
        },
        "precision": {
          "enum": [
            "year",
            "month",
            "day"
          ],
          "title": "Precision",
          "type": "string"
        },
        "year": {
          "maximum": 9999,
          "minimum": 1,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "precision",
        "year",
        "month",
        "day"
      ],
      "title": "PartialDate",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "$ref": "#/$defs/PartialDate"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Period",
      "type": "object"
    },
    "PrivateDetails": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "phone",
            "email",
            "messenger",
            "birth_date",
            "age",
            "platform_metadata"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SupportedText"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "PrivateDetails",
      "type": "object"
    },
    "ProposedFact": {
      "additionalProperties": false,
      "properties": {
        "importance": {
          "default": "normal",
          "enum": [
            "essential",
            "normal",
            "minor"
          ],
          "title": "Importance",
          "type": "string"
        },
        "jobTempId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jobtempid"
        },
        "kind": {
          "enum": [
            "text",
            "technology",
            "date",
            "metric",
            "leadership"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sourceId": {
          "title": "Sourceid",
          "type": "string"
        },
        "subprojectTempId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subprojecttempid"
        },
        "tempId": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tempid",
          "type": "string"
        },
        "unitIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Unitids",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextValue"
            },
            {
              "$ref": "#/$defs/TechnologyValue"
            },
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "$ref": "#/$defs/MetricValue"
            },
            {
              "$ref": "#/$defs/LeadershipValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "tempId",
        "kind",
        "value",
        "sourceId",
        "unitIds"
      ],
      "title": "ProposedFact",
      "type": "object"
    },
    "ProposedJob": {
      "additionalProperties": false,
      "properties": {
        "employer": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Employer",
          "type": "string"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/Period"
          },
          "maxItems": 20,
          "title": "Periods",
          "type": "array"
        },
        "role": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sourceId": {
          "title": "Sourceid",
          "type": "string"
        },
        "subprojects": {
          "items": {
            "$ref": "#/$defs/ProposedSubproject"
          },
          "maxItems": 100,
          "title": "Subprojects",
          "type": "array"
        },
        "tempId": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tempid",
          "type": "string"
        },
        "unitIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Unitids",
          "type": "array"
        }
      },
      "required": [
        "tempId",
        "employer",
        "role",
        "periods",
        "sourceId",
        "unitIds"
      ],
      "title": "ProposedJob",
      "type": "object"
    },
    "ProposedSubproject": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tempId": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tempid",
          "type": "string"
        },
        "unitIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Unitids",
          "type": "array"
        }
      },
      "required": [
        "tempId",
        "name",
        "unitIds"
      ],
      "title": "ProposedSubproject",
      "type": "object"
    },
    "SupportedText": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "text": {
          "maxLength": 4000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "title": "SupportedText",
      "type": "object"
    },
    "TechnologyValue": {
      "additionalProperties": false,
      "properties": {
        "canonicalId": {
          "minLength": 1,
          "title": "Canonicalid",
          "type": "string"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "scope": {
          "enum": [
            "global",
            "job",
            "subproject"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "canonicalId",
        "display",
        "scope"
      ],
      "title": "TechnologyValue",
      "type": "object"
    },
    "TextValue": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextValue",
      "type": "object"
    },
    "UnitProposal": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "facts",
            "administrative",
            "duplicate",
            "unresolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "duplicateOf": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicateof"
        },
        "factTempIds": {
          "items": {
            "type": "string"
          },
          "title": "Facttempids",
          "type": "array"
        },
        "sourceId": {
          "title": "Sourceid",
          "type": "string"
        },
        "unitId": {
          "title": "Unitid",
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "unitId",
        "disposition",
        "factTempIds"
      ],
      "title": "UnitProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/CandidateDetails"
    },
    "certifications": {
      "items": {
        "$ref": "#/$defs/CertificationDetails"
      },
      "maxItems": 40,
      "title": "Certifications",
      "type": "array"
    },
    "education": {
      "items": {
        "$ref": "#/$defs/EducationDetails"
      },
      "maxItems": 40,
      "title": "Education",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/ProposedFact"
      },
      "maxItems": 500,
      "title": "Facts",
      "type": "array"
    },
    "jobs": {
      "items": {
        "$ref": "#/$defs/ProposedJob"
      },
      "maxItems": 100,
      "title": "Jobs",
      "type": "array"
    },
    "languages": {
      "items": {
        "$ref": "#/$defs/LanguageDetails"
      },
      "maxItems": 40,
      "title": "Languages",
      "type": "array"
    },
    "nameAssessment": {
      "$ref": "#/$defs/NameAssessment"
    },
    "observationAssessment": {
      "$ref": "#/$defs/ObservationAssessment"
    },
    "privateDetails": {
      "items": {
        "$ref": "#/$defs/PrivateDetails"
      },
      "maxItems": 100,
      "title": "Privatedetails",
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/UnitProposal"
      },
      "maxItems": 5000,
      "title": "Units",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "jobs",
    "facts",
    "units",
    "candidate",
    "education",
    "certifications",
    "languages",
    "privateDetails",
    "nameAssessment",
    "observationAssessment"
  ],
  "title": "GuiSemanticProposal",
  "type": "object"
}
