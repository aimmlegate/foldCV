{
  "$defs": {
    "RewriteIssue": {
      "additionalProperties": false,
      "properties": {
        "blockId": {
          "title": "Blockid",
          "type": "string"
        },
        "code": {
          "enum": [
            "MISSING_REQUIRED",
            "QUALIFIER_LOSS",
            "ATTRIBUTION_LOSS",
            "SOURCE_REVIEW"
          ],
          "title": "Code",
          "type": "string"
        },
        "factId": {
          "title": "Factid",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "blockId",
        "factId",
        "message"
      ],
      "title": "RewriteIssue",
      "type": "object"
    },
    "RewritePreflightError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "NO_SAFE_CONTENT",
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "const": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "stage": {
          "const": "rewrite",
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "code",
        "retryable",
        "stage"
      ],
      "title": "RewritePreflightError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseRevision": {
      "minimum": 1,
      "title": "Baserevision",
      "type": "integer"
    },
    "blockId": {
      "minLength": 1,
      "title": "Blockid",
      "type": "string"
    },
    "blockRevision": {
      "minimum": 1,
      "title": "Blockrevision",
      "type": "integer"
    },
    "dependencyHash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dependencyhash",
      "type": "string"
    },
    "error": {
      "$ref": "#/$defs/RewritePreflightError"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/RewriteIssue"
      },
      "maxItems": 200,
      "title": "Issues",
      "type": "array"
    },
    "transportVersion": {
      "const": 1,
      "default": 1,
      "title": "Transportversion",
      "type": "integer"
    }
  },
  "required": [
    "error",
    "baseRevision",
    "blockId",
    "blockRevision",
    "dependencyHash",
    "issues"
  ],
  "title": "RewritePreflightFailure",
  "type": "object"
}
