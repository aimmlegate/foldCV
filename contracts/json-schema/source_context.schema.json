{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "discriminator": {
            "mapping": {
              "document": "#/$defs/DocumentAnchor",
              "field": "#/$defs/FieldAnchor",
              "section": "#/$defs/SectionAnchor"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FieldAnchor"
            },
            {
              "$ref": "#/$defs/SectionAnchor"
            },
            {
              "$ref": "#/$defs/DocumentAnchor"
            }
          ],
          "title": "Anchor"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "dependencies": {
          "$ref": "#/$defs/Dependencies"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "factIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Factids",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "removedFocus": {
          "items": {
            "$ref": "#/$defs/FocusRemoval"
          },
          "title": "Removedfocus",
          "type": "array"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "missing",
            "conflicting",
            "stale",
            "warning"
          ],
          "title": "Type",
          "type": "string"
        },
        "updateSuggestionId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Updatesuggestionid"
        }
      },
      "required": [
        "id",
        "type",
        "code",
        "anchor",
        "dependencies",
        "factIds",
        "reason",
        "evidence",
        "resolved",
        "updateSuggestionId",
        "removedFocus"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "Dependencies": {
      "additionalProperties": false,
      "properties": {
        "dependencyFingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dependencyfingerprint",
          "type": "string"
        },
        "documentRevision": {
          "minimum": 1,
          "title": "Documentrevision",
          "type": "integer"
        },
        "projectRevision": {
          "minimum": 1,
          "title": "Projectrevision",
          "type": "integer"
        },
        "rulesSha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rulessha256"
        },
        "sourceFingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sourcefingerprint",
          "type": "string"
        }
      },
      "required": [
        "projectRevision",
        "documentRevision",
        "rulesSha256",
        "sourceFingerprint",
        "dependencyFingerprint"
      ],
      "title": "Dependencies",
      "type": "object"
    },
    "DocumentAnchor": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "document",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DocumentAnchor",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "minLength": 1,
          "title": "Sourceid",
          "type": "string"
        },
        "sourceRevision": {
          "minimum": 1,
          "title": "Sourcerevision",
          "type": "integer"
        },
        "unitId": {
          "minLength": 1,
          "title": "Unitid",
          "type": "string"
        },
        "unitRevision": {
          "minimum": 1,
          "title": "Unitrevision",
          "type": "integer"
        }
      },
      "required": [
        "sourceId",
        "sourceRevision",
        "unitId",
        "unitRevision"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "minLength": 1,
          "title": "Sourceid",
          "type": "string"
        },
        "sourceRevision": {
          "minimum": 1,
          "title": "Sourcerevision",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unitId": {
          "minLength": 1,
          "title": "Unitid",
          "type": "string"
        },
        "unitRevision": {
          "minimum": 1,
          "title": "Unitrevision",
          "type": "integer"
        }
      },
      "required": [
        "sourceId",
        "sourceRevision",
        "unitId",
        "unitRevision",
        "text"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "FieldAnchor": {
      "additionalProperties": false,
      "properties": {
        "fieldId": {
          "minLength": 1,
          "title": "Fieldid",
          "type": "string"
        },
        "kind": {
          "const": "field",
          "title": "Kind",
          "type": "string"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "fieldId",
        "range"
      ],
      "title": "FieldAnchor",
      "type": "object"
    },
    "FocusRemoval": {
      "additionalProperties": false,
      "properties": {
        "catalogId": {
          "minLength": 1,
          "title": "Catalogid",
          "type": "string"
        },
        "reason": {
          "enum": [
            "duplicate",
            "unknown-ID",
            "missing-logo",
            "capacity"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "catalogId",
        "reason"
      ],
      "title": "FocusRemoval",
      "type": "object"
    },
    "LegacyText": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "factIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Factids",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "originalKind": {
          "title": "Originalkind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "visible": {
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "originalKind",
        "label",
        "text",
        "visible",
        "factIds",
        "evidence"
      ],
      "title": "LegacyText",
      "type": "object"
    },
    "Range": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Range",
      "type": "object"
    },
    "SectionAnchor": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "section",
          "title": "Kind",
          "type": "string"
        },
        "sectionId": {
          "minLength": 1,
          "title": "Sectionid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sectionId"
      ],
      "title": "SectionAnchor",
      "type": "object"
    },
    "SourceExcerpt": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/EvidenceSpan"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page"
        },
        "relation": {
          "enum": [
            "exact",
            "field",
            "block"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "evidence",
        "relation",
        "page"
      ],
      "title": "SourceExcerpt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "items": {
        "$ref": "#/$defs/Annotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "documentRevision": {
      "minimum": 1,
      "title": "Documentrevision",
      "type": "integer"
    },
    "excerpts": {
      "items": {
        "$ref": "#/$defs/SourceExcerpt"
      },
      "title": "Excerpts",
      "type": "array"
    },
    "legacyText": {
      "items": {
        "$ref": "#/$defs/LegacyText"
      },
      "title": "Legacytext",
      "type": "array"
    },
    "projectId": {
      "minLength": 1,
      "title": "Projectid",
      "type": "string"
    },
    "status": {
      "enum": [
        "evidence",
        "user-origin",
        "no-evidence",
        "stale"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "documentRevision",
    "status",
    "excerpts",
    "annotations",
    "legacyText"
  ],
  "title": "SourceContext",
  "type": "object"
}
