        }
      ]
    },
    "webAvailable": {
      "title": "Webavailable",
      "type": "boolean"
    }
  },
  "required": [
    "ready",
    "unavailable",
    "models",
    "webAvailable",
    "tools"
  ],
  "title": "AssistantCapabilitiesV1",
  "type": "object"
}
