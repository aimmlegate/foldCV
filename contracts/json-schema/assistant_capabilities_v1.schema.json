      },
      "maxItems": 100,
      "title": "Models",
      "type": "array"
    },
    "ready": {
      "title": "Ready",
      "type": "boolean"
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Tools",
      "type": "array"
    },
    "unavailable": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssistantErrorV1"
