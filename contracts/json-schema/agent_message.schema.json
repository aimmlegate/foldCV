        }
      },
      "then": {
        "properties": {
          "text": {
            "maxLength": 8000,
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "assistant"
          }
        }
      },
      "then": {
        "properties": {
          "text": {
