  "additionalProperties": false,
  "properties": {
    "baseRevision": {
      "minimum": 1,
      "title": "Baserevision",
      "type": "integer"
    },
    "blockId": {
      "minLength": 1,
      "title": "Blockid",
      "type": "string"
    },
    "blockKind": {
      "enum": [
        "profile",
        "job_prose"
      ],
      "title": "Blockkind",
      "type": "string"
    },
    "blockRevision": {
      "minimum": 1,
      "title": "Blockrevision",
      "type": "integer"
    },
    "contentPolicyVersion": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Contentpolicyversion",
      "type": "string"
    },
    "currentText": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Currenttext",
      "type": "string"
    },
    "dependencyHash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dependencyhash",
      "type": "string"
    },
    "excerpts": {
      "items": {
        "$ref": "#/$defs/RewriteExcerpt"
      },
      "maxItems": 200,
      "title": "Excerpts",
      "type": "array"
    },
    "facts": {
      "items": {
        "discriminator": {
          "mapping": {
            "date": "#/$defs/DateFact",
            "leadership": "#/$defs/LeadershipFact",
            "metric": "#/$defs/MetricFact",
            "technology": "#/$defs/TechnologyFact",
            "text": "#/$defs/TextFact"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TextFact"
          },
          {
            "$ref": "#/$defs/TechnologyFact"
          },
          {
            "$ref": "#/$defs/MetricFact"
          },
          {
            "$ref": "#/$defs/LeadershipFact"
          },
          {
            "$ref": "#/$defs/DateFact"
          }
        ]
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Facts",
      "type": "array"
    },
    "instruction": {
      "maxLength": 2000,
      "title": "Instruction",
      "type": "string"
    },
    "requiredFactIds": {
      "items": {
        "type": "string"
      },
      "maxItems": 200,
      "title": "Requiredfactids",
      "type": "array"
    },
    "sourceLanguage": {
      "enum": [
        "ru",
        "en",
        "mixed"
      ],
      "title": "Sourcelanguage",
      "type": "string"
    },
    "transportVersion": {
      "const": 1,
      "default": 1,
      "title": "Transportversion",
      "type": "integer"
    }
  },
  "required": [
    "baseRevision",
    "blockId",
    "blockKind",
    "blockRevision",
    "dependencyHash",
    "currentText",
    "instruction",
    "sourceLanguage",
    "contentPolicyVersion",
    "facts",
    "requiredFactIds",
    "excerpts"
  ],
  "title": "RewriteRequest",
  "type": "object"
