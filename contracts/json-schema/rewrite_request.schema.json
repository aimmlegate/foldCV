              "type": "null"
            }
          ],
          "title": "Subprojectid"
        },
        "value": {
          "$ref": "#/$defs/PartialDate"
        }
      },
      "required": [
        "id",
        "revision",
        "kind",
        "value",
        "evidence",
        "origin",
        "importance",
        "jobId",
        "subprojectId"
