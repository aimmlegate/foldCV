{
  "$defs": {
    "ActionCapture": {
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "minLength": 1,
          "title": "Actionid",
          "type": "string"
        },
        "actionToken": {
          "minimum": 0,
          "title": "Actiontoken",
          "type": "integer"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyStamp"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "sessionId": {
          "minLength": 1,
          "title": "Sessionid",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "actionId",
        "actionToken",
        "dependencies"
      ],
      "title": "ActionCapture",
      "type": "object"
    },
    "AgentJournalRequest": {
      "additionalProperties": false,
      "properties": {
        "allowEdits": {
          "title": "Allowedits",
          "type": "boolean"
        },
        "allowWeb": {
          "title": "Allowweb",
          "type": "boolean"
        },
        "clientRequestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Clientrequestid",
          "type": "string"
        },
        "conversationId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Conversationid",
          "type": "string"
        },
        "documentRevision": {
          "minimum": 1,
          "title": "Documentrevision",
          "type": "integer"
        },
        "factsRevision": {
          "minimum": 1,
          "title": "Factsrevision",
          "type": "integer"
        },
        "message": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "projectRevision": {
          "minimum": 1,
          "title": "Projectrevision",
          "type": "integer"
        },
        "scope": {
          "discriminator": {
            "mapping": {
              "resume": "#/$defs/WholeResumeScope",
              "selection": "#/$defs/SelectionScope"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/WholeResumeScope"
            },
            {
              "$ref": "#/$defs/SelectionScope"
            }
          ],
          "title": "Scope"
        },
        "selectionContext": {
          "anyOf": [
            {
              "$ref": "#/$defs/RichSelection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "settingsRevision": {
          "minimum": 1,
          "title": "Settingsrevision",
          "type": "integer"
        }
      },
      "required": [
        "clientRequestId",
        "conversationId",
        "message",
        "allowEdits",
        "allowWeb",
        "scope",
        "settingsRevision",
        "projectRevision",
        "documentRevision",
        "factsRevision"
      ],
      "title": "AgentJournalRequest",
      "type": "object"
    },
    "DependencyStamp": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fingerprint"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "block",
            "record",
            "field",
            "period",
            "ownership",
            "source",
            "rules",
            "asset",
            "timeline_order"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "fingerprint"
      ],
      "title": "DependencyStamp",
      "type": "object"
    },
    "JobAgentRequestV1": {
      "additionalProperties": false,
      "properties": {
        "lineage": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Lineage",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/AgentJournalRequest"
        },
        "requestEpoch": {
          "minimum": 1,
          "title": "Requestepoch",
          "type": "integer"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "lineage",
        "requestEpoch",
        "request"
      ],
      "title": "JobAgentRequestV1",
      "type": "object"
    },
    "RichPosition": {
      "additionalProperties": false,
      "properties": {
        "blockId": {
          "minLength": 1,
          "title": "Blockid",
          "type": "string"
        },
        "cellId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cellid"
        },
        "offset": {
          "description": "UTF-16 code units within the block or cell.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "blockId",
        "cellId",
        "offset"
      ],
      "title": "RichPosition",
      "type": "object"
    },
    "RichSelection": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/RichPosition"
        },
        "blockIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Blockids",
          "type": "array"
        },
        "capture": {
          "$ref": "#/$defs/ActionCapture"
        },
        "head": {
          "$ref": "#/$defs/RichPosition"
        },
        "kind": {
          "enum": [
            "text",
            "blocks",
            "table_cells"
          ],
          "title": "Kind",
          "type": "string"
        },
        "textSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Textsha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "anchor",
        "head",
        "blockIds",
        "capture",
        "textSha256"
      ],
      "title": "RichSelection",
      "type": "object"
    },
    "SelectionScope": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "selection",
          "title": "Kind",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/RichSelection"
        }
      },
      "required": [
        "kind",
        "selection"
      ],
      "title": "SelectionScope",
      "type": "object"
    },
    "WholeResumeScope": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "resume",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "WholeResumeScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": 1,
      "title": "Protocolversion",
      "type": "integer"
    },
    "request": {
      "$ref": "#/$defs/JobAgentRequestV1"
    },
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    }
  },
  "required": [
    "protocolVersion",
    "request"
  ],
  "title": "AssistantJobRequestV1",
  "type": "object"
}
