{
  "$defs": {
    "ProviderSelection": {
      "additionalProperties": false,
      "description": "Choices kept for a provider while another one is active; restored when it is selected again.",
      "properties": {
        "agentReasoningEffort": {
          "anyOf": [
            {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agentreasoningeffort"
        },
        "rewriteReasoningEffort": {
          "anyOf": [
            {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rewritereasoningeffort"
        },
        "selectedAgentModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selectedagentmodel"
        },
        "selectedFallbackModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selectedfallbackmodel"
        },
        "selectedImportModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selectedimportmodel"
        },
        "selectedModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selectedmodel"
        }
      },
      "title": "ProviderSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "automaticAnalysis": {
      "title": "Automaticanalysis",
      "type": "boolean"
    },
    "importMinutes": {
      "default": 60,
      "maximum": 240,
      "minimum": 5,
      "title": "Importminutes",
      "type": "integer"
    },
    "projectMegabytes": {
      "default": 64,
      "maximum": 256,
      "minimum": 10,
      "title": "Projectmegabytes",
      "type": "integer"
    },
    "providerSelections": {
      "additionalProperties": {
        "$ref": "#/$defs/ProviderSelection"
      },
      "propertyNames": {
        "enum": [
          "codex_cli",
          "claude_cli"
        ]
      },
      "title": "Providerselections",
      "type": "object"
    },
    "rewriteReasoningEffort": {
      "anyOf": [
        {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rewritereasoningeffort"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "selectedFallbackModel": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selectedfallbackmodel"
    },
    "selectedImportModel": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selectedimportmodel"
    },
    "selectedModel": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selectedmodel"
    },
    "selectedProvider": {
      "default": "codex_cli",
      "enum": [
        "codex_cli",
        "claude_cli"
      ],
      "title": "Selectedprovider",
      "type": "string"
    },
    "theme": {
      "enum": [
        "light",
        "dark",
        "system"
      ],
      "title": "Theme",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "automaticAnalysis",
    "theme",
    "selectedModel"
  ],
  "title": "Preferences",
  "type": "object"
}
