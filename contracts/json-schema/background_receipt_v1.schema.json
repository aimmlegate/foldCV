  "required": [
    "schemaVersion",
    "projectId",
    "lineage",
    "jobId",
    "proposalId",
    "clientMutationId",
    "requestSha256",
    "proposalSha256",
    "workspaceSha256",
    "generationsSha256",
    "projectRevision",
    "documentRevision",
    "factsRevision",
