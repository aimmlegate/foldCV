{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "discriminator": {
            "mapping": {
              "document": "#/$defs/DocumentAnchor",
              "field": "#/$defs/FieldAnchor",
              "section": "#/$defs/SectionAnchor"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FieldAnchor"
            },
            {
              "$ref": "#/$defs/SectionAnchor"
            },
            {
              "$ref": "#/$defs/DocumentAnchor"
            }
          ],
          "title": "Anchor"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "dependencies": {
          "$ref": "#/$defs/Dependencies"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "factIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Factids",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "removedFocus": {
          "items": {
            "$ref": "#/$defs/FocusRemoval"
          },
          "title": "Removedfocus",
          "type": "array"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "missing",
            "conflicting",
            "stale",
            "warning"
          ],
          "title": "Type",
          "type": "string"
        },
        "updateSuggestionId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Updatesuggestionid"
        }
      },
      "required": [
        "id",
        "type",
        "code",
        "anchor",
        "dependencies",
        "factIds",
        "reason",
        "evidence",
        "resolved",
        "updateSuggestionId",
        "removedFocus"
      ],
      "title": "Annotation",
      "type": "object"
    },
