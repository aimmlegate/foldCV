{
  "$defs": {
    "AssistantAvailabilityV1": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "reasonCode": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoncode"
        },
        "remedy": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Remedy"
        },
        "state": {
          "enum": [
            "available",
            "permission_disabled",
            "missing_input",
            "temporarily_unavailable",
            "unsupported"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "reasonCode",
        "reason",
        "remedy"
      ],
      "title": "AssistantAvailabilityV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "availability": {
      "$ref": "#/$defs/AssistantAvailabilityV1"
    },
    "catalogRevision": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Catalogrevision",
      "type": "string"
    },
    "needsPlanning": {
      "title": "Needsplanning",
      "type": "boolean"
    },
    "projectId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Projectid",
      "type": "string"
    },
    "protocolVersion": {
      "const": 1,
      "default": 1,
      "title": "Protocolversion",
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "taskId": {
      "anyOf": [
        {
          "enum": [
            "read_resume",
            "check_resume",
            "draft_text",
            "rewrite_resume",
            "correct_facts",
            "restructure",
            "format_document",
            "project_metadata",
            "sources",
            "images",
            "archive_project",
            "restore_project",
            "delete_project",
            "undo",
            "redo",
            "export_docx",
            "export_project",
            "read_public_page",
            "export_pdf",
            "shell",
            "apps",
            "send_application",
            "import_resume"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Taskid"
    }
  },
  "required": [
    "projectId",
    "catalogRevision",
    "taskId",
    "availability",
    "needsPlanning"
  ],
  "title": "AssistantTaskCheckV1",
  "type": "object"
}
