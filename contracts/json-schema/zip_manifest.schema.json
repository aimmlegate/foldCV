{
  "$defs": {
    "ZipEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "project",
            "source_original",
            "source_extracted",
            "template_asset",
            "render",
            "checks"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uncompressedSize": {
          "minimum": 0,
          "title": "Uncompressedsize",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "role",
        "sha256",
        "uncompressedSize"
      ],
      "title": "ZipEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "appVersion": {
      "title": "Appversion",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ZipEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "projectId": {
      "minLength": 1,
      "title": "Projectid",
      "type": "string"
    },
    "rendererVersion": {
      "title": "Rendererversion",
      "type": "string"
    },
    "schemaVersion": {
      "const": 3,
      "title": "Schemaversion",
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "appVersion",
    "rendererVersion",
    "projectId",
    "entries"
  ],
  "title": "ZipManifest",
  "type": "object"
}
