{
  "$defs": {
    "ActionCapture": {
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "minLength": 1,
          "title": "Actionid",
          "type": "string"
        },
        "actionToken": {
          "minimum": 0,
          "title": "Actiontoken",
          "type": "integer"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyStamp"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "sessionId": {
          "minLength": 1,
          "title": "Sessionid",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "actionId",
        "actionToken",
        "dependencies"
      ],
      "title": "ActionCapture",
      "type": "object"
    },
    "DependencyStamp": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fingerprint"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "block",
            "record",
            "field",
            "period",
            "ownership",
            "source",
            "rules",
            "asset",
            "timeline_order"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "fingerprint"
      ],
      "title": "DependencyStamp",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "else": {
    "if": {
      "properties": {
        "operation": {
          "enum": [
            "add_to_focus",
            "remove_from_focus"
          ]
        }
      },
      "required": [
        "operation"
      ]
    },
    "then": {
      "properties": {
        "jobId": {
          "type": "null"
        },
        "periodId": {
          "type": "null"
        },
        "recordId": {
          "type": "string"
        },
        "recordKind": {
          "enum": [
            null,
            "technology"
          ]
        },
        "values": {
          "maxProperties": 0
        }
      },
      "required": [
        "recordId"
      ]
    }
  },
  "if": {
    "properties": {
      "operation": {
        "const": "clear_technologies"
      }
    },
    "required": [
      "operation"
    ]
  },
  "properties": {
    "beforeRecordId": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Beforerecordid"
    },
    "capture": {
      "$ref": "#/$defs/ActionCapture"
    },
    "documentRevision": {
      "minimum": 1,
      "title": "Documentrevision",
      "type": "integer"
    },
    "factsRevision": {
      "minimum": 1,
      "title": "Factsrevision",
      "type": "integer"
    },
    "jobId": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Jobid"
    },
    "operation": {
      "enum": [
        "add",
        "edit",
        "remove",
        "add_period",
        "remove_period",
        "clear_technologies",
        "add_to_focus",
        "remove_from_focus",
        "move_technology",
        "move_focus"
      ],
      "title": "Operation",
      "type": "string"
    },
    "periodId": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Periodid"
    },
    "recordId": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recordid"
    },
    "recordKind": {
      "anyOf": [
        {
          "enum": [
            "candidate",
            "employment",
            "technology",
            "education",
            "language",
            "claim"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recordkind"
    },
    "values": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 50,
      "title": "Values",
      "type": "object"
    }
  },
  "required": [
    "operation",
    "factsRevision",
    "documentRevision",
    "capture"
  ],
  "then": {
    "properties": {
      "periodId": {
        "type": "null"
      },
      "recordId": {
        "type": "null"
      },
      "recordKind": {
        "const": "technology"
      },
      "values": {
        "maxProperties": 0
      }
    },
    "required": [
      "recordKind"
    ]
  },
  "title": "RichPanelRequest",
  "type": "object"
}
