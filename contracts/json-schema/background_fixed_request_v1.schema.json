{
  "$defs": {
    "ActionCapture": {
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "minLength": 1,
          "title": "Actionid",
          "type": "string"
        },
        "actionToken": {
          "minimum": 0,
          "title": "Actiontoken",
          "type": "integer"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyStamp"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "sessionId": {
          "minLength": 1,
          "title": "Sessionid",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "actionId",
        "actionToken",
        "dependencies"
      ],
      "title": "ActionCapture",
      "type": "object"
    },
    "DependencyStamp": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fingerprint"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "block",
            "record",
            "field",
            "period",
            "ownership",
            "source",
            "rules",
            "asset",
            "timeline_order"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "fingerprint"
      ],
      "title": "DependencyStamp",
      "type": "object"
    },
    "FieldReference": {
      "additionalProperties": false,
      "properties": {
        "fieldKey": {
          "minLength": 1,
          "title": "Fieldkey",
          "type": "string"
        },
        "recordId": {
          "minLength": 1,
          "title": "Recordid",
          "type": "string"
        },
        "rootId": {
          "minLength": 1,
          "title": "Rootid",
          "type": "string"
        }
      },
      "required": [
        "recordId",
        "fieldKey",
        "rootId"
      ],
      "title": "FieldReference",
      "type": "object"
    },
    "FixedCompletionCommand": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "completion",
          "title": "Kind",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/RichCompletionRequest"
        }
      },
      "required": [
        "kind",
        "request"
      ],
      "title": "FixedCompletionCommand",
      "type": "object"
    },
    "FixedPanelCommand": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "panel",
          "title": "Kind",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/RichPanelSyncRequest"
        }
      },
      "required": [
        "kind",
        "request"
      ],
      "title": "FixedPanelCommand",
      "type": "object"
    },
    "FixedProcessingCommand": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "processing",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "FixedProcessingCommand",
      "type": "object"
    },
    "FixedRetryCommand": {
      "additionalProperties": false,
      "properties": {
        "capture": {
          "$ref": "#/$defs/ActionCapture"
        },
        "kind": {
          "enum": [
            "retry",
            "resolve"
          ],
          "title": "Kind",
          "type": "string"
        },
        "syncId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Syncid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "syncId",
        "capture"
      ],
      "title": "FixedRetryCommand",
      "type": "object"
    },
    "FixedRewriteCommand": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "rewrite",
          "title": "Kind",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/RichRewriteRequest"
        }
      },
      "required": [
        "kind",
        "request"
      ],
      "title": "FixedRewriteCommand",
      "type": "object"
    },
    "RichCompletionRequest": {
      "additionalProperties": false,
      "properties": {
        "blockIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Blockids",
          "type": "array"
        },
        "capture": {
          "$ref": "#/$defs/ActionCapture"
        },
        "interpret": {
          "default": true,
          "title": "Interpret",
          "type": "boolean"
        },
        "movedIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Movedids",
          "type": "array"
        },
        "removedFields": {
          "items": {
            "$ref": "#/$defs/FieldReference"
          },
          "maxItems": 100,
          "title": "Removedfields",
          "type": "array"
        },
        "removedRecordIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Removedrecordids",
          "type": "array"
        }
      },
      "required": [
        "capture",
        "blockIds",
        "movedIds",
        "removedFields"
      ],
      "title": "RichCompletionRequest",
      "type": "object"
    },
    "RichPanelSyncRequest": {
      "additionalProperties": false,
      "properties": {
        "capture": {
          "$ref": "#/$defs/ActionCapture"
        },
        "recordIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Recordids",
          "type": "array"
        }
      },
      "required": [
        "capture",
        "recordIds"
      ],
      "title": "RichPanelSyncRequest",
      "type": "object"
    },
    "RichPosition": {
      "additionalProperties": false,
      "properties": {
        "blockId": {
          "minLength": 1,
          "title": "Blockid",
          "type": "string"
        },
        "cellId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cellid"
        },
        "offset": {
          "description": "UTF-16 code units within the block or cell.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "blockId",
        "cellId",
        "offset"
      ],
      "title": "RichPosition",
      "type": "object"
    },
    "RichRewriteRequest": {
      "additionalProperties": false,
      "properties": {
        "instruction": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/RichSelection"
        }
      },
      "required": [
        "selection",
        "instruction"
      ],
      "title": "RichRewriteRequest",
      "type": "object"
    },
    "RichSelection": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/RichPosition"
        },
        "blockIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Blockids",
          "type": "array"
        },
        "capture": {
          "$ref": "#/$defs/ActionCapture"
        },
        "head": {
          "$ref": "#/$defs/RichPosition"
        },
        "kind": {
          "enum": [
            "text",
            "blocks",
            "table_cells"
          ],
          "title": "Kind",
          "type": "string"
        },
        "textSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Textsha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "anchor",
        "head",
        "blockIds",
        "capture",
        "textSha256"
      ],
      "title": "RichSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "clientRequestId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Clientrequestid",
      "type": "string"
    },
    "command": {
      "discriminator": {
        "mapping": {
          "completion": "#/$defs/FixedCompletionCommand",
          "panel": "#/$defs/FixedPanelCommand",
          "processing": "#/$defs/FixedProcessingCommand",
          "resolve": "#/$defs/FixedRetryCommand",
          "retry": "#/$defs/FixedRetryCommand",
          "rewrite": "#/$defs/FixedRewriteCommand"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FixedProcessingCommand"
        },
        {
          "$ref": "#/$defs/FixedCompletionCommand"
        },
        {
          "$ref": "#/$defs/FixedRewriteCommand"
        },
        {
          "$ref": "#/$defs/FixedPanelCommand"
        },
        {
          "$ref": "#/$defs/FixedRetryCommand"
        }
      ],
      "title": "Command"
    },
    "lineage": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Lineage",
      "type": "string"
    },
    "requestEpoch": {
      "minimum": 1,
      "title": "Requestepoch",
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "lineage",
    "requestEpoch",
    "clientRequestId",
    "command"
  ],
  "title": "JobFixedRequestV1",
  "type": "object"
}
