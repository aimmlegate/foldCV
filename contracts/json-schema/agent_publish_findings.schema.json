{
  "$defs": {
    "AgentFindingInput": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "sourceIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Sourceids",
          "type": "array"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/AgentFindingTarget"
          },
          "maxItems": 20,
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "severity",
        "message",
        "targets",
        "sourceIds"
      ],
      "title": "AgentFindingInput",
      "type": "object"
    },
    "AgentFindingTarget": {
      "additionalProperties": false,
      "properties": {
        "blockId": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blockid"
        },
        "cellId": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cellid"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End"
        },
        "fieldKey": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fieldkey"
        },
        "recordId": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recordid"
        },
        "snapshotId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Snapshotid",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        }
      },
      "required": [
        "snapshotId",
        "blockId",
        "cellId",
        "recordId",
        "fieldKey",
        "start",
        "end"
      ],
      "title": "AgentFindingTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/AgentFindingInput"
      },
      "maxItems": 20,
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "findings"
  ],
  "title": "AgentPublishFindings",
  "type": "object"
}
