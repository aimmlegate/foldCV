{
  "$defs": {
    "ActionOp": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "rename",
            "formatting_date",
            "archive",
            "restore",
            "delete"
          ],
          "title": "Action",
          "type": "string"
        },
        "op": {
          "const": "action",
          "title": "Op",
          "type": "string"
        },
        "targetId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targetid"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "op",
        "action"
      ],
      "title": "ActionOp",
      "type": "object"
    },
    "AssistantChangeProposalV1": {
      "additionalProperties": false,
      "properties": {
        "appliedRevision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Appliedrevision"
        },
        "baseRevision": {
          "minimum": 1,
          "title": "Baserevision",
          "type": "integer"
        },
        "conversationId": {
          "minLength": 1,
          "title": "Conversationid",
          "type": "string"
        },
        "createdAt": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Createdat",
          "type": "string"
        },
        "expectedActionId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expectedactionid"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "edit",
            "history",
            "action"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ops": {
          "items": {
            "discriminator": {
              "mapping": {
                "action": "#/$defs/ActionOp",
                "create_fact": "#/$defs/CreateFactOp",
                "delete_blocks": "#/$defs/DeleteBlocksOp",
                "delete_fact": "#/$defs/DeleteFactOp",
                "format_block": "#/$defs/FormatBlockOp",
                "history": "#/$defs/HistoryOp",
                "insert_blocks": "#/$defs/InsertBlocksOp",
                "move_block": "#/$defs/MoveBlockOp",
                "replace_text": "#/$defs/ReplaceTextOp",
                "set_block_text": "#/$defs/SetBlockTextOp",
                "update_fact": "#/$defs/UpdateFactOp"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SetBlockTextOp"
              },
              {
                "$ref": "#/$defs/ReplaceTextOp"
              },
              {
                "$ref": "#/$defs/InsertBlocksOp"
              },
              {
                "$ref": "#/$defs/DeleteBlocksOp"
              },
              {
                "$ref": "#/$defs/MoveBlockOp"
              },
              {
                "$ref": "#/$defs/FormatBlockOp"
              },
              {
                "$ref": "#/$defs/UpdateFactOp"
              },
              {
                "$ref": "#/$defs/CreateFactOp"
              },
              {
                "$ref": "#/$defs/DeleteFactOp"
              },
              {
                "$ref": "#/$defs/HistoryOp"
              },
              {
                "$ref": "#/$defs/ActionOp"
              }
            ]
          },
          "maxItems": 100,
          "title": "Ops",
          "type": "array"
        },
        "preview": {
          "items": {
            "$ref": "#/$defs/PreviewEntryV1"
          },
          "maxItems": 200,
          "title": "Preview",
          "type": "array"
        },
        "projectId": {
          "minLength": 1,
          "title": "Projectid",
          "type": "string"
        },
        "runId": {
          "minLength": 1,
          "title": "Runid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "state": {
          "enum": [
            "draft",
            "applied",
            "discarded"
          ],
          "title": "State",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "title": "Summary",
          "type": "string"
        },
        "touched": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "maxProperties": 500,
          "title": "Touched",
          "type": "object"
        },
        "updatedAt": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Updatedat",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "projectId",
        "conversationId",
        "runId",
        "kind",
        "summary",
        "baseRevision",
        "touched",
        "ops",
        "preview",
        "state",
        "appliedRevision",
        "createdAt",
        "updatedAt"
      ],
      "title": "AssistantChangeProposalV1",
      "type": "object"
    },
