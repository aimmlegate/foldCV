{
  "$defs": {
    "AgentOwner": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "token": {
          "maxLength": 128,
          "minLength": 32,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "token",
        "epoch"
      ],
      "title": "AgentOwner",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contentSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contentsha256",
      "type": "string"
    },
    "owner": {
      "$ref": "#/$defs/AgentOwner"
    },
    "proposalId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Proposalid",
      "type": "string"
    },
    "protocolVersion": {
      "const": 1,
      "title": "Protocolversion",
      "type": "integer"
    },
    "requestSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Requestsha256",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "ticket": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Ticket",
      "type": "string"
    },
    "version": {
      "maximum": 20,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "protocolVersion",
    "proposalId",
    "version",
    "contentSha256",
    "owner",
    "ticket",
    "requestSha256"
  ],
  "title": "AssistantProposalCommitV1",
  "type": "object"
}
