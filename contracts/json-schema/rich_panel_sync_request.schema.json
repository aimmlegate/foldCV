{
  "$defs": {
    "ActionCapture": {
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "minLength": 1,
          "title": "Actionid",
          "type": "string"
        },
        "actionToken": {
          "minimum": 0,
          "title": "Actiontoken",
          "type": "integer"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyStamp"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "sessionId": {
          "minLength": 1,
          "title": "Sessionid",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "actionId",
        "actionToken",
        "dependencies"
      ],
      "title": "ActionCapture",
      "type": "object"
    },
    "DependencyStamp": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fingerprint"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "block",
            "record",
            "field",
            "period",
            "ownership",
            "source",
            "rules",
            "asset",
            "timeline_order"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "fingerprint"
      ],
      "title": "DependencyStamp",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capture": {
      "$ref": "#/$defs/ActionCapture"
    },
    "recordIds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Recordids",
      "type": "array"
    }
  },
  "required": [
    "capture",
    "recordIds"
  ],
  "title": "RichPanelSyncRequest",
  "type": "object"
}
