        "blockId": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blockid"
        },
        "cellId": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cellid"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyStamp"
          },
          "maxItems": 100,
          "title": "Dependencies",
          "type": "array"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End"
        },
        "fieldKey": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fieldkey"
        },
        "recordId": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recordid"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "text": {
          "maxLength": 4000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "blockId",
        "cellId",
        "recordId",
        "fieldKey",
        "start",
        "end",
        "text",
        "dependencies"
      ],
      "title": "AgentAnchor",
      "type": "object"
    },
    "AgentError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "AGENT_DISABLED",
            "AGENT_MODEL_REQUIRED",
            "AGENT_MODEL_UNAVAILABLE",
            "AGENT_MODEL_INCOMPATIBLE",
            "AGENT_SETTINGS_CONFLICT",
            "AGENT_SETTINGS_CORRUPT",
            "AGENT_SETTINGS_SAVE_FAILED",
            "AGENT_CONNECTION_UNAVAILABLE",
            "AGENT_CONNECTION_CHANGED",
            "AGENT_AUTH_REQUIRED",
            "AGENT_QUOTA",
            "AGENT_BUSY",
            "AGENT_CANCELLED",
            "AGENT_INTERRUPTED",
            "AGENT_DEADLINE",
            "AGENT_STARTUP_TIMEOUT",
            "AGENT_PROTOCOL",
            "AGENT_PROCESS_FAILED",
            "AGENT_CLEANUP_FAILED",
            "AGENT_RUNTIME_UNSUPPORTED",
            "AGENT_MODEL_REROUTED",
            "AGENT_UNEXPECTED_COMPACTION",
            "AGENT_TOOL_DENIED",
            "AGENT_TOOL_LIMIT",
            "AGENT_OUTPUT_LIMIT",
            "AGENT_CONTEXT_LIMIT",
            "AGENT_ARGUMENT_INVALID",
            "AGENT_WEB_DISABLED",
            "AGENT_SOURCE_UNAVAILABLE",
            "AGENT_SOURCE_DENIED",
            "AGENT_SOURCE_LIMIT",
            "AGENT_SCOPE_INVALID",
            "AGENT_STALE_READ",
            "AGENT_EDIT_INVALID",
            "AGENT_EDIT_LIMIT",
            "AGENT_EVIDENCE_INVALID",
            "AGENT_NO_OWNER",
            "AGENT_LEASE_EXPIRED",
            "AGENT_OWNER_MISMATCH",
            "AGENT_TICKET_INVALID",
            "AGENT_RECEIPT_TIMEOUT",
            "AGENT_SAVE_FAILED",
            "AGENT_OUTCOME_UNKNOWN",
            "AGENT_IDEMPOTENCY_CONFLICT",
            "AGENT_NOT_FOUND",
            "AGENT_CONVERSATION_FULL",
            "AGENT_PROJECT_FULL",
            "AGENT_STORE_CORRUPT",
            "AGENT_STORE_UNAVAILABLE",
            "AGENT_STORE_SAVE_FAILED",
            "AGENT_PROJECT_DELETED",
            "AGENT_CLEANUP_INCOMPLETE",
            "AGENT_RESYNC_REQUIRED"
