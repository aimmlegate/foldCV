        "savedBatchId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Savedbatchid"
        },
        "scope": {
          "discriminator": {
            "mapping": {
              "resume": "#/$defs/WholeResumeScope",
              "selection": "#/$defs/SelectionScope"
