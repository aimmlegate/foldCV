{
  "$defs": {
    "ActionCapture": {
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "minLength": 1,
          "title": "Actionid",
          "type": "string"
        },
        "actionToken": {
          "minimum": 0,
          "title": "Actiontoken",
          "type": "integer"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyStamp"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "sessionId": {
          "minLength": 1,
          "title": "Sessionid",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "actionId",
        "actionToken",
        "dependencies"
      ],
      "title": "ActionCapture",
      "type": "object"
    },
    "DependencyStamp": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fingerprint"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "block",
            "record",
            "field",
            "period",
            "ownership",
            "source",
            "rules",
            "asset",
            "timeline_order"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "fingerprint"
      ],
      "title": "DependencyStamp",
      "type": "object"
    },
    "RichPosition": {
      "additionalProperties": false,
      "properties": {
        "blockId": {
          "minLength": 1,
          "title": "Blockid",
          "type": "string"
        },
        "cellId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cellid"
        },
        "offset": {
          "description": "UTF-16 code units within the block or cell.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "blockId",
        "cellId",
        "offset"
      ],
      "title": "RichPosition",
      "type": "object"
    },
    "RichSelection": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/RichPosition"
        },
        "blockIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Blockids",
          "type": "array"
        },
        "capture": {
          "$ref": "#/$defs/ActionCapture"
        },
        "head": {
          "$ref": "#/$defs/RichPosition"
        },
        "kind": {
          "enum": [
            "text",
            "blocks",
            "table_cells"
          ],
          "title": "Kind",
          "type": "string"
        },
        "textSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Textsha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "anchor",
        "head",
        "blockIds",
        "capture",
        "textSha256"
      ],
      "title": "RichSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "instruction": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Instruction",
      "type": "string"
    },
    "previewOnly": {
      "default": false,
      "title": "Previewonly",
      "type": "boolean"
    },
    "selection": {
      "$ref": "#/$defs/RichSelection"
    }
  },
  "required": [
    "selection",
    "instruction"
  ],
  "title": "RichRewriteRequest",
  "type": "object"
}
