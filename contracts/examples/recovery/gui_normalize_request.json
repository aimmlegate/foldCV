            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": []
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_2",
          "revision": 1,
          "order": 1,
          "text": "Север, backend-разработчик, 2021 — настоящее время.\n",
          "location": {
            "kind": "pasted",
            "index": 1,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": []
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_3",
          "revision": 1,
          "order": 2,
          "text": "Сервис обработки заказов. Python, PostgreSQL.\n",
          "location": {
            "kind": "pasted",
            "index": 2,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": []
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_4",
          "revision": 1,
          "order": 3,
          "text": "Делала REST API для заказов, писала интеграционные тесты.\n",
          "location": {
            "kind": "pasted",
            "index": 3,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": []
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_5",
          "revision": 1,
          "order": 4,
          "text": "Командой сократили время обработки со 100 до 70 мс, на 30%.\n",
          "location": {
            "kind": "pasted",
            "index": 4,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": []
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_6",
          "revision": 1,
          "order": 5,
          "text": "Обучила двух новых разработчиков.\n",
          "location": {
            "kind": "pasted",
            "index": 5,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": []
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_7",
          "revision": 1,
          "order": 6,
          "text": "Запад, разработчик, 2017–2020. Внутренняя CRM. Java, MySQL.\n",
          "location": {
            "kind": "pasted",
            "index": 6,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": []
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_8",
          "revision": 1,
          "order": 7,
          "text": "Поддерживала CRM и исправляла ошибки.\n",
          "location": {
            "kind": "pasted",
            "index": 7,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": []
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_9",
          "revision": 1,
          "order": 8,
          "text": "Восток, разработчик, 2008–2009. PHP. Разрабатывала отчёты.\n",
          "location": {
            "kind": "pasted",
            "index": 8,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": []
        },
