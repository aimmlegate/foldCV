      "units": [
        {
          "id": "source_dc297781ca355d302cd6f084/unit_1",
          "revision": 1,
          "order": 0,
          "text": "Ирина Примерова, backend-разработчик.\n",
          "location": {
            "kind": "pasted",
            "index": 0,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": [
            "fact_4175dac4d44d14e7d016fa88",
            "fact_94d6008bb15aa6acfc6a0b29",
            "fact_562b829c85fb35070588cee8",
            "fact_a878c8de46c31076fe88e88a"
          ]
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_2",
          "revision": 1,
          "order": 1,
          "text": "Север, backend-разработчик, 2021 — настоящее время.\n",
          "location": {
            "kind": "pasted",
            "index": 1,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": [
            "fact_a878c8de46c31076fe88e88a"
          ]
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_3",
          "revision": 1,
          "order": 2,
          "text": "Сервис обработки заказов. Python, PostgreSQL.\n",
          "location": {
            "kind": "pasted",
            "index": 2,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": [
            "fact_a878c8de46c31076fe88e88a"
          ]
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_4",
          "revision": 1,
          "order": 3,
          "text": "Делала REST API для заказов, писала интеграционные тесты.\n",
          "location": {
            "kind": "pasted",
            "index": 3,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": [
            "fact_a878c8de46c31076fe88e88a"
          ]
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_5",
          "revision": 1,
          "order": 4,
          "text": "Командой сократили время обработки со 100 до 70 мс, на 30%.\n",
          "location": {
            "kind": "pasted",
            "index": 4,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": [
            "fact_a878c8de46c31076fe88e88a"
          ]
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_6",
          "revision": 1,
          "order": 5,
          "text": "Обучила двух новых разработчиков.\n",
          "location": {
            "kind": "pasted",
            "index": 5,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": [
            "fact_a878c8de46c31076fe88e88a"
          ]
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_7",
          "revision": 1,
          "order": 6,
          "text": "Запад, разработчик, 2017–2020. Внутренняя CRM. Java, MySQL.\n",
          "location": {
            "kind": "pasted",
            "index": 6,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": [
            "fact_a878c8de46c31076fe88e88a"
          ]
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_8",
          "revision": 1,
          "order": 7,
          "text": "Поддерживала CRM и исправляла ошибки.\n",
          "location": {
            "kind": "pasted",
            "index": 7,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": [
            "fact_a878c8de46c31076fe88e88a"
          ]
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_9",
          "revision": 1,
          "order": 8,
          "text": "Восток, разработчик, 2008–2009. PHP. Разрабатывала отчёты.\n",
          "location": {
            "kind": "pasted",
            "index": 8,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": [
            "fact_a878c8de46c31076fe88e88a"
          ]
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_10",
          "revision": 1,
          "order": 9,
          "text": "Образование: Учебный технический университет, прикладная информатика, 2016.\n",
          "location": {
            "kind": "pasted",
            "index": 9,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": [
            "fact_12517227d18df32befaacd49",
            "fact_f05ee804cecbe1c57fef43be",
            "fact_90914182617afab012eecd32",
            "fact_a878c8de46c31076fe88e88a"
          ]
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_11",
          "revision": 1,
          "order": 10,
          "text": "Языки: русский — родной, английский — B2.\n",
          "location": {
            "kind": "pasted",
            "index": 10,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": [
            "fact_671be645cf934533a38dfe46",
            "fact_7a27a7b6c84ec125f93bebe5",
            "fact_1170c9039e92756d17ba4780",
            "fact_32d9e14a7e5e49cbf06068a8",
            "fact_a878c8de46c31076fe88e88a"
          ]
        },
        {
          "id": "source_dc297781ca355d302cd6f084/unit_12",
          "revision": 1,
          "order": 11,
          "text": "Общие навыки: Docker.\n",
          "location": {
            "kind": "pasted",
            "index": 11,
            "row": null,
            "column": null
          },
          "disposition": "unresolved",
          "representedFactIds": [
            "fact_a878c8de46c31076fe88e88a"
          ]
        }
      ],
